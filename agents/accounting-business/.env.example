# Configuration for UK Accounting Agent Business

# OpenAI API
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4

# Gumroad API
GUMROAD_API_KEY=your-gumroad-token-here

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret
REDDIT_USER_AGENT=accounting-agent/1.0

# Twitter/X API
TWITTER_API_KEY=your-twitter-key
TWITTER_API_SECRET=your-twitter-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# Stripe (for payment processing)
STRIPE_API_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# Bank Details (for deposits)
BANK_SORT_CODE=your-sort-code
BANK_ACCOUNT=your-account-number

# Settings
DEBUG=false
LOG_LEVEL=info
TIMEZONE=Europe/London
